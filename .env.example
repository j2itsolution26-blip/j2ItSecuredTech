# ---------------------------------------------------------------------------
# Database — PostgreSQL (Neon, Supabase, RDS or local)
# ---------------------------------------------------------------------------
# Neon: use the POOLED connection string (host contains "-pooler") for the app.
DATABASE_URL="postgresql://user:password@localhost:5432/j2securetech?schema=public"

# ---------------------------------------------------------------------------
# Authentication — Auth.js v5
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Public site URL — used for canonical links, sitemap and OpenGraph
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Cloudinary — optional. Without it the media library accepts URLs only.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Seed account — read by `npm run db:seed` only
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@j2securetech.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="System Administrator"
